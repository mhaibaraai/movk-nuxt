{
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": ["* 6-9 * * 1"],
  "packageRules": [
    {
      "matchDepTypes": ["peerDependencies", "resolutions"],
      "enabled": false
    },
    {
      "matchPackageNames": ["h3"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "reka-ui 须与 @nuxt/ui 锁定版本一致，随 @nuxt/ui 手动对齐",
      "matchPackageNames": ["reka-ui"],
      "enabled": false
    }
  ]
}
